{
  "manifest_version": 3,
  "name": "drift — a steering layer for your feed",
  "version": "1.0.0",
  "description": "Point your recommendation feed in a direction you choose: Novelty, Rabbit hole, Detox, Touch grass, or your own terms. Local, honest, no flooding.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "drift" },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "src/lexicons.js",
        "src/profile.js",
        "src/directions.js",
        "src/adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
